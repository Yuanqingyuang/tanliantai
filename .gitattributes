# 链碳台（CHAINPCF）换行与文本处理约定
# 作用：跨平台统一换行（仓库内一律 LF），并声明二进制文件避免被 diff/换行转换破坏
# 与 .editorconfig 配套使用

# 默认：按内容自动判定文本，文本文件在仓库内统一存为 LF
* text=auto eol=lf

# Windows 专用脚本保持 CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制资源与文档：不做换行转换、不参与文本 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.pptx  binary
*.docx  binary
*.xlsx  binary
*.zip   binary

# 生成物与锁文件：在 diff 中折叠，便于评审
*.lock  linguist-generated=true
